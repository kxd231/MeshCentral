<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <link rel="icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/favicon-303x303.png" />
    {{{customCSSTags}}}
    <title>RDP</title>
    <script type="text/javascript">
        var webRdpGfx = '{{{webrdpgfx}}}'; // settings.webRdp.gfx: 'on' (default), 'off' or 'dev'
        var webRdpH264 = '{{{webrdph264}}}'; // settings.webRdp.h264: 'on' (default) or 'off' (no H.264 / AVC capability sets)
        var rdpjs = ['shared/limits', 'shared/constants', 'shared/errors', 'keyboard', 'flow', 'messages', 'fallback', 'rdp-client']; for (var rdpi = 0; rdpi < rdpjs.length; rdpi++) { document.write('<scr' + 'ipt type="text/javascript" src="rdp/' + rdpjs[rdpi] + '.js"></scr' + 'ipt>'); }
        // Web-RDP texts live in the views so translate/translate.js can extract and translate them.
        var webRdpErrors = {
            RDP_ERROR_RELAY_FAILED: "The relay to the agent could not be established",
            RDP_ERROR_CONNECT_FAILED: "The agent could not connect to the RDP server",
            RDP_ERROR_CONNECTION_LOST: "The connection to the RDP server was lost",
            RDP_ERROR_TIMEOUT: "The RDP server did not respond in time",
            RDP_ERROR_STANDARD_SECURITY_UNSUPPORTED: "The RDP server only offers Standard RDP Security (RC4), which is not supported; enable TLS or NLA on the server",
            RDP_ERROR_SECURITY_NEGOTIATION: "The RDP server rejected the security protocol",
            RDP_ERROR_TLS_FAILED: "The TLS connection to the RDP server failed",
            RDP_ERROR_CERT_CHANGED: "The certificate of the RDP server differs from the one trusted for this device, the session was refused before any credential was sent",
            RDP_ERROR_TRUST_RACE: "Another session pinned a different certificate for this device at the same moment, the session was ended; credentials may already have reached the endpoint of this session, check the device and the network and try again",
            RDP_ERROR_NLA_DOWNGRADE: "The RDP server no longer offers NLA, which it offered before, the session was refused before any credential was sent",
            RDP_ERROR_NO_CREDENTIALS: "No credentials were provided",
            RDP_ERROR_AUTHENTICATION_FAILED: "Authentication failed, check the username and password",
            RDP_ERROR_PASSWORD_EXPIRED: "The password has expired",
            RDP_ERROR_PASSWORD_MUST_CHANGE: "The password must be changed before logging on",
            RDP_ERROR_ACCOUNT_LOCKED: "The account is locked",
            RDP_ERROR_ACCOUNT_DISABLED: "The account is disabled or has expired",
            RDP_ERROR_ACCOUNT_RESTRICTION: "Account restrictions prevent this logon (logon hours, workstation, ...)",
            RDP_ERROR_LOGON_TYPE_NOT_GRANTED: "The user is not allowed to log on through Remote Desktop",
            RDP_ERROR_ACCESS_DENIED: "Access denied by the RDP server",
            RDP_ERROR_LICENSING: "The RDP server could not issue a license",
            RDP_ERROR_CAPABILITIES_REJECTED: "The RDP server does not support the requested graphics mode, try the GFX mode",
            RDP_ERROR_H264_REQUIRED: "The RDP server requires H.264, which this browser cannot decode",
            RDP_ERROR_SERVER_DENIED: "The RDP server denied the connection",
            RDP_ERROR_SERVER_DISCONNECTED: "The RDP server ended the session",
            RDP_ERROR_PROTOCOL: "The RDP server sent invalid data",
            RDP_ERROR_RESOURCE_LIMIT: "A resource limit was exceeded, the session was closed",
            RDP_ERROR_TOO_MANY_SESSIONS: "Too many Web-RDP sessions are open on this server",
            RDP_ERROR_CLIENT_STALLED: "The browser stopped processing the session, it was closed",
            RDP_ERROR_CLIENT_DECODE: "The browser could not decode the image data",
            RDP_ERROR_CLIENT_PROTOCOL: "The browser sent invalid data, the session was closed",
            RDP_ERROR_INTERNAL: "Internal error in the Web-RDP engine"
        };
        var webRdpHints = {
            'use-gfx': "Try the GFX graphics mode.",
            'use-legacy': "Try classic bitmaps.",
            'enable-tls': "Enable TLS or Network Level Authentication on the RDP server.",
            'enable-h264': "The server needs H.264, which this browser cannot decode.",
            'check-credentials': "Check the username, password and domain."
        };
        function webRdpErrorText(info) {
            var text = info.message || info.text || '';
            var base = RdpShared.errors.descriptions[info.code];
            if (base && webRdpErrors[info.code] && text.indexOf(base) === 0) {
                text = webRdpErrors[info.code] + text.substring(base.length);
            }
            var hints = {
                'use-gfx': 'Try the GFX graphics mode.',
                'use-legacy': 'Try the legacy graphics mode.',
                'enable-tls': 'Enable TLS or Network Level Authentication on the RDP server.',
                'enable-h264': 'The server needs H.264, which this browser cannot decode.',
                'check-credentials': 'Check the username, password and domain.'
            };
            // The standalone wrapper retains text but does not retain the hint id.
            for (var hint in hints) { text = text.replace(hints[hint], webRdpHints[hint]); }
            var suffixes = [
                ['If the remote desktop did not open, check the username, password, domain and Remote Desktop logon permissions for the account on the remote computer.', "If the remote desktop did not open, check the username, password, domain and Remote Desktop logon permissions for the account on the remote computer."],
                ['Pinned certificate SHA-256: none.', "Pinned certificate SHA-256: none."],
                ['Pinned certificate SHA-256: ', "Pinned certificate SHA-256: "],
                ['Certificate presented now: ', "Certificate presented now: "],
                ['Ask an administrator of the device to accept the new certificate.', "Ask an administrator of the device to accept the new certificate."]
            ];
            for (var i = 0; i < suffixes.length; i++) { text = text.replace(suffixes[i][0], suffixes[i][1]); }
            return text;
        }

    </script>
    {{{customJSTags}}}
    <style>
        :focus {
            outline: 0;
        }

        body {
            font-family:sans-serif;
            margin: 0;
            background-color: black;
        }

        .container {
            background-color:cadetblue;
            background: linear-gradient(to bottom right, #003366, #0055AA);
        }

        .middleContainer {
            color: lightgray;
            position: absolute;
            top: 50%;
            left: 50%;
            -moz-transform: translateX(-50%) translateY(-50%);
            -webkit-transform: translateX(-50%) translateY(-50%);
            transform: translateX(-50%) translateY(-50%);
        }

        .signinform {
            width: 380px;
            margin: 0 auto;
        }

        .formDropdown {
            font-size: 17px;
        }

        .formLabel { }

        .formControl {
            width:calc(100% - 16px);
            font-size: 17px;
            border-radius: 5px;
        }

        .connectButton, .legacyButton {
            margin-top: 6px;
            width: 100%;
            padding: 6px;
            font-size: 16px;
            border-radius: 5px;
            cursor:pointer;
        }

        .graphicsNote {
            position: fixed;
            top: 6px;
            right: 8px;
            z-index: 10;
            padding: 3px 8px;
            font-size: 12px;
            color: #ffd54a;
            background-color: rgba(0,0,0,0.6);
            border-radius: 4px;
            pointer-events: none;
        }

        .mainCanvas {
            max-width: 100vw; /* Scale a larger remote desktop down to the window, keeping its aspect ratio */
            max-height: 100vh;
            position: absolute;
            top: 50%;
            left: 50%;
            -moz-transform: translateX(-50%) translateY(-50%);
            -webkit-transform: translateX(-50%) translateY(-50%);
            transform: translateX(-50%) translateY(-50%);
        }
    </style>
    <script language="javascript">
        var random = '{{{randomlength}}}' // Random length string for BREACH mitigation
        var client = null;
        var canvas = null;
        var urlargs = parseUriArgs();
        if (urlargs.key && (isAlphaNumeric(urlargs.key) == false)) { delete urlargs.key; }
        var cookie = '{{{cookie}}}';
        var serverCredentials = parseInt('{{{serverCredentials}}}');
        var name = decodeURIComponent('{{{name}}}');
        if (name != '') { document.title = name + ' - ' + document.title; }
        var features = parseInt('{{{features}}}');

        function load() {
            if (name != '') { QH('computerName', EscapeHtml(name)); }
            client = RdpClient.createStandalone(Q('myCanvas'), { onNotice: function (n) { if (n.id == 'legacy-fallback') { QH('graphicsNote', EscapeHtml(rdpErrorText(n))); QV('graphicsNote', true); console.info('Web-RDP: GFX failed (' + n.code + '), using legacy graphics'); } } });
            // Graphics (Auto / Lossless / Classic bitmaps) only where the server allows GFX; the choice is remembered in this browser like the other RDP options
            if (((webRdpGfx == 'on') || (webRdpGfx == 'dev'))) {
                QV('rowgraphics', true);
                try { var g = localStorage.getItem('webrdpGraphics'); if ((g == 'legacy') || (g == 'lossless')) { Q('inputGraphics').value = g; } } catch (ex) { }
            }
            Q('inputDomain').focus();
            canvas = Q('myCanvas');
            if (cookie == '') {
                QE('inputDomain', false);
                QE('inputUsername', false);
                QE('inputPassword', false);
                QE('connectButton', false);
            }

            if (serverCredentials == 1) {
                QV('dropdowndomain', true);
                Q('d3coreMode').value = 1;
            } else {
                QV('dropdowndomain', false);
                Q('d3coreMode').value = 2;
            }
            dropDownChange();
        }

        function connect(domain, username, password, legacyOnce) {
            if (cookie == '') return;
            var domain = Q('inputDomain').value;
            var username = Q('inputUsername').value;
            var password = Q('inputPassword').value;
            var savepass = Q('inputSaveCredentials').checked;
            var options = { savepass: savepass, useServerCreds: (Q('d3coreMode').value == 1) };
            if (typeof urlargs.flags == 'number') { options.flags = urlargs.flags; }
            if (((webRdpGfx == 'on') || (webRdpGfx == 'dev'))) {
                var graphics = ((Q('inputGraphics').value == 'legacy') || (Q('inputGraphics').value == 'lossless')) ? Q('inputGraphics').value : 'auto';
                try { localStorage.setItem('webrdpGraphics', graphics); } catch (ex) { }
                options.graphics = (legacyOnce === true) ? 'legacy' : graphics; // the reconnect after a GFX failure is not remembered
            }
            QV('graphicsNote', false);
            QV('legacyAction', false);
            QV('myCanvas', true);
            QV('main', false);
            QV('errorMessage', false);
            client.connect(cookie, domain, username, password, options, function (err) {
                QV('myCanvas', false);
                QV('main', true);
                QV('graphicsNote', false);
                if (err) { QH('errorMessage', EscapeHtml(rdpErrorText(err))); QV('errorMessage', true); }
                // GFX failed after the picture was shown: the form still holds the values of this connect; connect again with classic bitmaps
                if (err && (err.offerLegacy === true)) { QV('legacyAction', true); }
            });
            return false;
        }

        // Readable text for errors from the JavaScript Web-RDP client.
        function rdpErrorText(err) {
            if (err && (err.id == 'legacy-fallback')) return "Simplified graphics (classic bitmaps)" + ': ' + err.code;
            if ((err != null) && (typeof err == 'object') && (typeof err.text == 'string')) return webRdpErrorText(err);
            var name = ((err != null) && (typeof err == 'object')) ? err.code : err;
            var detail = ((err != null) && (typeof err == 'object')) ? err.detail : null;
            return "RDP error: " + name + ((typeof detail == 'number') ? (' (' + detail + ')') : '');
        }

        function Q(x) { return document.getElementById(x); }                            // "Q"
        function QS(x) { try { return Q(x).style; } catch (x) { } }                     // "Q" style
        function QE(x, y) { try { Q(x).disabled = !y; } catch (x) { } }                 // "Q" enable
        function QV(x, y) { try { QS(x).display = (y ? '' : 'none'); } catch (x) { } }  // "Q" visible
        function QA(x, y) { Q(x).innerHTML += y; }                                      // "Q" append
        function QH(x, y) { Q(x).innerHTML = y; }                                       // "Q" html
        function QC(x) { try { return Q(x).classList; } catch (x) { } }                 // "Q" class
        function EscapeHtml(x) { if (typeof x == 'string') return x.replace(/&/g, '&amp;').replace(/>/g, '&gt;').replace(/</g, '&lt;').replace(/"/g, '&quot;').replace(/'/g, '&apos;'); if (typeof x == 'boolean') return x; if (typeof x == 'number') return x; }
        function EscapeHtmlBreaks(x) { if (typeof x == 'string') return x.replace(/&/g, '&amp;').replace(/>/g, '&gt;').replace(/</g, '&lt;').replace(/"/g, '&quot;').replace(/'/g, '&apos;').replace(/\r/g, '<br />').replace(/\n/g, '').replace(/\t/g, '&nbsp;&nbsp;'); if (typeof x == 'boolean') return x; if (typeof x == 'number') return x; }

        // String validation
        function isAlphaNumeric(str) { return (str.match(/^[A-Za-z0-9]+$/) != null); };
        function isSafeString(str) { return ((typeof str == 'string') && (str.indexOf('<') == -1) && (str.indexOf('>') == -1) && (str.indexOf('&') == -1) && (str.indexOf('"') == -1) && (str.indexOf('\'') == -1) && (str.indexOf('+') == -1) && (str.indexOf('(') == -1) && (str.indexOf(')') == -1) && (str.indexOf('#') == -1) && (str.indexOf('%') == -1) && (str.indexOf(':') == -1)) };

        // Parse URL arguments, only keep safe values
        function parseUriArgs() {
            var href = window.document.location.href;
            if (href.endsWith('#')) { href = href.substring(0, href.length - 1); }
            var name, r = {}, parsedUri = href.split(/[\?&|\=]/);
            parsedUri.splice(0, 1);
            for (x in parsedUri) {
                switch (x % 2) {
                    case 0: { name = decodeURIComponent(parsedUri[x]); break; }
                    case 1: {
                        r[name] = decodeURIComponent(parsedUri[x]);
                        if (!isSafeString(r[name])) { delete r[name]; } else { var x = parseInt(r[name]); if (x == r[name]) { r[name] = x; } }
                        break;
                    } default: { break; }
                }
            }
            return r;
        }

        function dropDownChange() {
            var newCreds = (Q('d3coreMode').value == 2);
            QV('rowdomain', newCreds);
            QV('rowusername', newCreds);
            QV('rowpassword', newCreds);
            QV('rowremember', newCreds && ((features & 1) == 0));
            if (newCreds) Q('inputUsername').focus();
        }

    </script>
</head>
<body onload='load()' style="position:absolute;top:0px;right:0;left:0;bottom:0px">
    <div id="main" class="container" style="position:absolute;top:0px;right:0;left:0;bottom:0px">
        <div class="middleContainer">
            <div id="computerName" style="width:100%;text-align:center;font-size:24px"></div>
            <table class="signinform">
                <tr>
                    <td colspan="2"><hr style="color:gray;border:1px solid;" /></td>
                </tr>
                <tr id="dropdowndomain" style="display:none">
                    <td colspan="2">
                        <select id=d3coreMode style=width:100%;margin-bottom:5px class="formDropdown" onchange="dropDownChange()"><option value=1>Use server credentials</option><option value=2>Use new credentials</option></select>
                    </td>
                </tr>
                <tr id="rowdomain" style="display:none">
                    <td><label for="inputDomain" class="formLabel">Domain</label></td>
                    <td style="text-align:right"><input type="text" id="inputDomain" class="formControl" placeholder="Domain"></td>
                </tr>
                <tr id="rowusername" style="display:none">
                    <td><label for="inputUsername" class="formLabel">Username</label></td>
                    <td style="text-align:right"><input type="text" id="inputUsername" class="formControl" placeholder="Username"></td>
                </tr>
                <tr id="rowpassword" style="display:none">
                    <td><label for="inputPassword" class="formLabel">Password</label></td>
                    <td style="text-align:right"><input type="password" id="inputPassword" class="formControl" placeholder="Password"></td>
                </tr>
                <tr id="rowremember" style="display:none">
                    <td></td>
                    <td><label><input type="checkbox" id="inputSaveCredentials" style="margin-left:8px;margin-right:5px">Remember credentials</label></td>
                </tr>
                <tr id="rowgraphics" style="display:none">
                    <td><label for="inputGraphics" class="formLabel">Graphics</label></td>
                    <td style="text-align:right"><select id="inputGraphics" class="formDropdown" style="width:calc(100% - 16px)"><option value="auto" notransval="1">Auto</option><option value="lossless" notransval="1">Lossless</option><option value="legacy" notransval="1">Classic bitmaps</option></select></td>
                </tr>
                <tr>
                    <td colspan="2"><div id="errorMessage" style="display:none;color:#e04040;text-align:center;margin:6px 0"></div></td>
                </tr>
                <tr>
                    <td colspan="2"><button id="legacyAction" class="legacyButton" style="display:none" onclick="return connect(null, null, null, true)">Reconnect with classic bitmaps</button></td>
                </tr>
                <tr>
                    <td colspan="2"><button class="connectButton" onclick="return connect()">Connect</button></td>
                </tr>
            </table>
        </div>
    </div>
    <div id="graphicsNote" class="graphicsNote" style="display:none"></div>
    <canvas id="myCanvas" class="mainCanvas" style="display:none" />
</body>
</html>
